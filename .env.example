# meumcp - Environment Configuration
# Copy to .env and fill in values

# === MCP Server ===
MCP_SERVER_NAME=meumcp
MCP_SERVER_VERSION=1.0.0
MCP_TRANSPORT=stdio  # stdio | http
MCP_PORT=8765
MCP_HOST=127.0.0.1

# === Logging ===
LOG_LEVEL=info

# === Knowledge Sources ===
GOOGLE_DOCS_SOURCE_URL=https://docs.google.com/document/d/1sTsRoAEWrU-1ltOMmUWyQ-18DFTmYl0R5UZc-QnNtCs/edit
LOCAL_RULES_DIR=./rules

# === Supabase (for knowledge storage, optional) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=

# === GitHub ===
GITHUB_TOKEN=
GITHUB_OWNER=canalqb
GITHUB_REPO=meumcp

# === BrightData (optional - existing MCP integration) ===
BRIGHTDATA_API_TOKEN=
