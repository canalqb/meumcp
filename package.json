{
  "name": "meumcp",
  "version": "1.0.0",
  "description": "Central MCP server for knowledge, rules, agents and MCP integration for the @CanalQb ecosystem",
  "author": "CanalQb",
  "license": "MIT",
  "bin": {
    "meumcp": "./dist/cli.js"
  },
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.json",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "chokidar": "^4.0.0",
    "commander": "^15.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^13.0.0",
    "picocolors": "^1.1.0",
    "pino": "^9.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/supertest": "^2.0.12",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
