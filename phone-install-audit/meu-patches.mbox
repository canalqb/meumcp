+            html += `
+                <div class="permission-group">
+                    <h4><i class="fas fa-folder"></i> ${module}</h4>
+                    <ul>
+                        ${perms.map(perm => `
+                            <li class="${perm.allowed ? 'allowed' : 'denied'}">
