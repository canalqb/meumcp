+}
+
+.cms_table-striped tbody tr:nth-child(odd) {
+  background-color: var(--cms-bg-secondary);
+}
+
+/* ============================================
+   10. ABAS (TABS)
+   ============================================ */
+
+.cms_tabs {
+  display: flex;
+  border-bottom: 2px solid var(--cms-border-color);
+  margin-bottom: var(--cms-spacing-lg);
+}
+
+.cms_tab-button {
+  padding: var(--cms-spacing-md) var(--cms-spacing-lg);
+  background: none;
+  border: none;
+  border-bottom: 3px solid transparent;
+  color: var(--cms-text-secondary);
+  font-weight: 500;
