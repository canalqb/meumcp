+\</section\>  
+\<script\>  
+(function(){ 'use strict';  
+  var btns=document.querySelectorAll('.post\_faq\_question');  
+  btns.forEach(function(btn){  
+    function toggle(){  
+      var ans=btn.nextElementSibling;  
+      var aberto=ans.classList.contains('post\_faq\_show');  
+      document.querySelectorAll('.post\_faq\_answer').forEach(function(a){a.classList.remove('post\_faq\_show');a.setAttribute('aria-hidden','true');});  
+      document.querySelectorAll('.post\_faq\_question').forEach(function(q){q.classList.remove('post\_faq\_active');q.setAttribute('aria-expanded','false');});  
+      if(\!aberto){ans.classList.add('post\_faq\_show');ans.setAttribute('aria-hidden','false');btn.classList.add('post\_faq\_active');btn.setAttribute('aria-expanded','true');}  
+    }  
+    btn.addEventListener('click',toggle);  
+    btn.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle();}});  
+  });  
+})();  
+\</script\>  
