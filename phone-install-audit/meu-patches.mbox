+    ");
+    $stmt->bind_param("ss", $recurso_id, $tipo_recurso);
+    $stmt->execute();
+    $result = $stmt->get_result();
+    
+    $resultado = [
+        'tem_privilegio' => false,
+        'sempre_visivel' => false,
+        'requer_pontos' => false,
+        'pontos_minimos' => 0
+    ];
+    
+    if ($result->num_rows > 0) {
