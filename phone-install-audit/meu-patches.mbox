+  const body = document.body;
+  
+  if (themeName === 'dark') {
+    body.classList.add('cms-dark-mode');
+  } else {
+    body.classList.remove('cms-dark-mode');
+  }
+  
+  CMS.theme = themeName;
+  localStorage.setItem('cms_theme', themeName);
+  
+  if (CMS.debugMode) {
+    console.log('[CMS] Tema aplicado: ' + themeName);
+  }
+};
+
